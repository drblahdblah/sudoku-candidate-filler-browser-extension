{
  "manifest_version": 3,
  "name": "Sudoku Candidate Filler",
  "version": "0.1.0",
  "description": "Fills standard Sudoku candidates on supported puzzle pages.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.theage.com.au/puzzles/sudoku/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Refresh Sudoku candidates"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.theage.com.au/puzzles/sudoku/*"],
      "js": ["src/candidates.js", "src/grid-dom.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
