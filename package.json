{
  "name": "sudoku-candidate-filler-browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "WebExtension that fills standard Sudoku candidates on supported puzzle pages.",
  "scripts": {
    "build": "node scripts/build.js",
    "build:chromium": "node scripts/build.js --target chromium",
    "build:firefox": "node scripts/build.js --target firefox",
    "build:safari": "node scripts/build.js --target safari",
    "generate:safari-wrapper": "node scripts/generate-safari-wrapper.js",
    "generate:icons": "node scripts/generate-icons.js",
    "package": "node scripts/package.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  }
}
